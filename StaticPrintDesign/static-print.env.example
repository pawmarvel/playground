# Shared local settings for the static print review, generation, and publication service.
# Copy to ignored work/static-print.env and edit it. The serve and publish
# commands reload that file automatically on every process start. Source it
# manually only when separate shell commands need these values.

STATIC_PRINT_REVIEWER_ACCESS_CODE=replace-with-reviewer-code
STATIC_PRINT_OPERATOR_ACCESS_CODE=replace-with-different-operator-code

OPENAI_API_KEY=replace-with-openai-api-key
# Auto keeps meaningful filenames and uses one low-detail vision request only
# for obvious generated/export names (for example ChatGPT, IMG, or timestamps).
# Use semantic to analyze every new image, or filename to analyze none.
STATIC_PRINT_DESIGN_ID_MODE=auto
STATIC_PRINT_DESIGN_ID_MODEL=gpt-5.4-mini
STATIC_PRINT_SUBJECT_MODEL=gpt-image-2.5-sunburst
STATIC_PRINT_SUBJECT_QUALITY=high
# Launch-tier defaults. Image request starts are evenly paced rather than sent
# as a burst; corrective image retries consume the same quota.
STATIC_PRINT_IMAGE_REQUESTS_PER_MINUTE=50
STATIC_PRINT_IMAGE_MAX_CONCURRENCY=50
STATIC_PRINT_IMAGE_MAX_ATTEMPTS=4
STATIC_PRINT_IMAGE_RETRY_BASE_SECONDS=10
# A low-detail vision check rejects a wrong featured species before commit.
STATIC_PRINT_SUBJECT_VALIDATION_MODEL=gpt-5.4-mini

STATIC_PRINT_S3_BUCKET=replace-with-static-print-bucket
STATIC_PRINT_S3_PREFIX='templates/static_design'
AWS_PROFILE=replace-with-aws-profile
AWS_REGION=us-east-1
# Immutable assets upload concurrently. Uploads and preflight reads retry only
# throttling, timeout, connection, and transient 5xx failures.
STATIC_PRINT_S3_UPLOAD_MAX_CONCURRENCY=16
STATIC_PRINT_S3_MAX_ATTEMPTS=4
STATIC_PRINT_S3_RETRY_BASE_SECONDS=1
