{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pawmarvel.com/schemas/static-release-catalog-v1.schema.json",
  "title": "PawMarvel immutable static print release catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "release_id", "created_at", "bundles"],
  "properties": {
    "schema": {"const": "pawmarvel-static-release-catalog-v1"},
    "release_id": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}\\.[0-9]{3}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "bundles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["bundle_id", "design_id", "product_profile_id", "version_id", "manifest_path", "manifest_sha256"],
        "properties": {
          "bundle_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*--subject-[a-z0-9]+(?:-[a-z0-9]+)*--[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "design_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*--subject-[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "product_profile_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "version_id": {"type": "string", "pattern": "^v[0-9]{6}$"},
          "manifest_path": {"type": "string", "pattern": "^bundles/.+/v[0-9]{6}/bundle\\.json$"},
          "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
