{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pawmarvel.com/schemas/static-bundle-v1.schema.json",
  "title": "PawMarvel immutable static print bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "bundle_type", "bundle_id", "design_id", "product_profile_id", "version_id", "created_at", "source_sha256", "preview", "print_targets", "provenance", "assets"],
  "properties": {
    "schema": {"const": "pawmarvel-static-bundle-v1"},
    "bundle_type": {"const": "static-design"},
    "bundle_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*--subject-[a-z0-9]+(?:-[a-z0-9]+)*--[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "design_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*--subject-[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "product_profile_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "version_id": {"type": "string", "pattern": "^v[0-9]{6}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "preview": {"$ref": "#/$defs/imageReference"},
    "print_targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target_id", "path", "width", "height", "dpi", "color_space", "background"],
        "properties": {
          "target_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "path": {"type": "string", "pattern": "^print/[a-z0-9]+(?:-[a-z0-9]+)*\\.png$"},
          "width": {"type": "integer", "minimum": 1},
          "height": {"type": "integer", "minimum": 1},
          "dpi": {"type": "integer", "minimum": 1},
          "color_space": {"const": "sRGB"},
          "background": {"type": "string", "pattern": "^(transparent|#[0-9A-Fa-f]{6})$"},
          "physical_width_inches": {"type": "number", "exclusiveMinimum": 0},
          "physical_height_inches": {"type": "number", "exclusiveMinimum": 0}
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generator_version"],
      "properties": {"generator_version": {"type": "string", "minLength": 1}}
    },
    "assets": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/asset"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "imageReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "width", "height"],
      "properties": {
        "path": {"const": "preview.png"},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1}
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes", "media_type", "width", "height"],
      "properties": {
        "path": {"type": "string", "pattern": "^(preview\\.png|print/[a-z0-9]+(?:-[a-z0-9]+)*\\.png)$"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 1},
        "media_type": {"const": "image/png"},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1}
      }
    }
  }
}
