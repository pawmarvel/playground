{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pawmarvel.com/schemas/static-subject-catalog-v1.schema.json",
  "title": "PawMarvel static design expansion subject catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "design_id_pattern", "workspace_pattern", "subject_id_contract", "expansion_policy", "subjects"],
  "properties": {
    "schema": {"const": "pawmarvel-static-subject-catalog-v1"},
    "design_id_pattern": {"const": "<seed-design-id>--subject-<subject-id>"},
    "workspace_pattern": {"const": "<seed-design-id>/<subject-id>"},
    "subject_id_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority", "format", "immutable"],
      "properties": {
        "authority": {"const": "explicit-subject-id"},
        "format": {"const": "lowercase-kebab-case"},
        "immutable": {"const": true}
      }
    },
    "expansion_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seed_approval_required", "allow_partial_subject_coverage", "preserve_seed_canvas_dimensions", "product_generation_requires_subject_approval"],
      "properties": {
        "seed_approval_required": {"const": true},
        "allow_partial_subject_coverage": {"const": true},
        "preserve_seed_canvas_dimensions": {"const": true},
        "product_generation_requires_subject_approval": {"const": true}
      }
    },
    "subjects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["priority", "subject_id", "display_name", "subject_kind", "collection_handle", "collection_path", "hero_strategy"],
        "properties": {
          "priority": {"type": "integer", "minimum": 1},
          "subject_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "display_name": {"type": "string", "minLength": 1},
          "subject_kind": {"enum": ["dog-breed", "dog-general", "cat-general", "cat-coat"]},
          "collection_handle": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "collection_path": {"type": "string", "pattern": "^/collections/[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "hero_strategy": {"enum": ["breed-specific", "mixed-breed-heroes", "mixed-coat-heroes", "black-coat-heroes"]}
        }
      }
    }
  }
}
