{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pawmarvel.com/schemas/static-catalog-v1.schema.json",
  "title": "PawMarvel static design discovery catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "updated_at", "products"],
  "properties": {
    "schema": {"const": "pawmarvel-static-catalog-v1"},
    "updated_at": {"type": "string", "format": "date-time"},
    "products": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["bundle_id", "design_id", "product_profile_id", "status", "latest_version_id", "versions"],
        "properties": {
          "bundle_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*--subject-[a-z0-9]+(?:-[a-z0-9]+)*--[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "design_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*--subject-[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "product_profile_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "status": {"enum": ["active", "retired"]},
          "status_changed_at": {"type": "string", "format": "date-time"},
          "status_reason": {"type": "string", "minLength": 1, "maxLength": 1000},
          "latest_version_id": {"type": "string", "pattern": "^v[0-9]{6}$"},
          "versions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["version_id", "release_id", "published_at", "manifest_path", "manifest_sha256"],
              "properties": {
                "version_id": {"type": "string", "pattern": "^v[0-9]{6}$"},
                "release_id": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}\\.[0-9]{3}$"},
                "published_at": {"type": "string", "format": "date-time"},
                "manifest_path": {"type": "string", "pattern": "^bundles/.+/v[0-9]{6}/bundle\\.json$"},
                "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
              }
            }
          }
        }
      }
    }
  }
}
