{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pawmarvel.com/schemas/layout-reference-v1.schema.json",
  "title": "PawMarvel authoring layout reference",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "reference_image_sha256", "pet_region", "name_region"],
  "properties": {
    "schema_version": {"const": 1},
    "reference_image_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "pet_region": {"$ref": "#/$defs/region"},
    "name_region": {"$ref": "#/$defs/region"}
  },
  "$defs": {
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": {"type": "integer", "minimum": 0},
        "y": {"type": "integer", "minimum": 0},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1}
      }
    }
  }
}
