{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pawmarvel.com/schemas/release-catalog-v2.schema.json",
  "title": "PawMarvel immutable bundle release catalog v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "release_id", "created_at", "templates"],
  "properties": {
    "schema_version": {"const": 2},
    "release_id": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}\\.[0-9]{3}$"},
    "created_at": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "templates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["template_id", "design_id", "product_profile_id", "bundle_revision", "manifest_path", "manifest_sha256"],
        "properties": {
          "template_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*--[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 127},
          "design_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "minLength": 3, "maxLength": 64},
          "product_profile_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 64},
          "bundle_revision": {"type": "integer", "minimum": 1},
          "manifest_path": {"type": "string", "pattern": "^bundles/[a-z0-9]+(?:-[a-z0-9]+)*--[a-z0-9]+(?:-[a-z0-9]+)*/v[0-9]{6}/bundle\\.json$"},
          "manifest_url": {"type": "string", "format": "uri", "pattern": "^https://[^/?#@]+(?:/[^?#]*)?$"},
          "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
