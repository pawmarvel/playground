{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pawmarvel.example/schemas/print-targets-v1.schema.json",
  "title": "PawMarvel additive print targets v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "primary_target_id",
    "source_bundle",
    "layout_policy",
    "targets",
    "approval"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "primary_target_id": {"type": "string", "pattern": "^[1-9][0-9]*x[1-9][0-9]*$"},
    "source_bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["template_id", "bundle_revision", "manifest_sha256"],
      "properties": {
        "template_id": {"type": "string", "minLength": 1},
        "bundle_revision": {"type": "integer", "minimum": 1},
        "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "layout_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coverage", "horizontal_alignment", "vertical_alignment", "pet_fit", "pet_anchor"],
      "properties": {
        "coverage": {"const": 0.95},
        "horizontal_alignment": {"const": "center"},
        "vertical_alignment": {"const": "center"},
        "pet_fit": {"const": "contain-visible-alpha"},
        "pet_anchor": {"const": "center"}
      }
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target_id", "canvas", "art", "layout", "art_sha256", "layout_sha256"],
        "properties": {
          "target_id": {"type": "string", "pattern": "^[1-9][0-9]*x[1-9][0-9]*$"},
          "canvas": {
            "type": "object",
            "additionalProperties": false,
            "required": ["width", "height"],
            "properties": {
              "width": {"type": "integer", "minimum": 1},
              "height": {"type": "integer", "minimum": 1}
            }
          },
          "art": {"type": "string", "pattern": "^print/[1-9][0-9]*x[1-9][0-9]*/art\\.png$"},
          "layout": {"type": "string", "pattern": "^print/[1-9][0-9]*x[1-9][0-9]*/layout\\.json$"},
          "art_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "layout_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "approved_at", "approved_by", "notes", "candidate_id", "candidate_sha256", "contact_sheet_sha256"],
      "properties": {
        "status": {"const": "approved"},
        "approved_at": {"type": "string", "format": "date-time"},
        "approved_by": {"type": "string", "minLength": 1},
        "notes": {"type": "string", "minLength": 1},
        "candidate_id": {"type": "string", "minLength": 1},
        "candidate_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "contact_sheet_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
