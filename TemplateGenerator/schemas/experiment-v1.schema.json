{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pawmarvel.com/schemas/experiment-v1.schema.json",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "experiment_id",
    "kind",
    "design_id",
    "product_profile_id",
    "status",
    "inputs",
    "generator",
    "created_at"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "experiment_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]+[a-z0-9]$"
    },
    "kind": {"enum": ["art", "pet", "layout"]},
    "status": {"enum": ["draft", "evaluated", "discarded"]},
    "inputs": {
      "type": "object",
      "properties": {
        "references": {
          "type": "array",
          "minItems": 0,
          "items": {"type": "object"}
        },
        "layout_references": {
          "type": "array",
          "minItems": 0,
          "maxItems": 4,
          "items": {"type": "object"}
        },
        "reference_mode": {
          "enum": ["finished-design", "art-template"]
        }
      }
    },
    "generation": {
      "type": ["object", "null"],
      "properties": {
        "provider": {"enum": ["openai", "gemini", "local"]},
        "model": {"type": "string"},
        "transport": {
          "enum": ["images.edits", "images.generations", "interactions", "local.empty-canvas"]
        },
        "input_mode": {
          "enum": ["reference-guided", "prompt-only", "pet-and-prompt", "empty-canvas"]
        },
        "parameters": {
          "type": "object",
          "properties": {
            "quality": {"enum": ["low", "medium", "high", "auto"]}
          }
        },
        "prompt_variables": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "pet_name": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "generator": {
      "type": "object",
      "required": ["version"],
      "properties": {
        "version": {"type": "string"}
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "generation": {
            "type": "object",
            "properties": {"input_mode": {"const": "empty-canvas"}},
            "required": ["input_mode"]
          }
        },
        "required": ["generation"]
      },
      "then": {
        "properties": {
          "kind": {"const": "art"},
          "inputs": {
            "properties": {"references": {"maxItems": 0}},
            "not": {"required": ["prompt"]}
          },
          "generation": {
            "properties": {
              "provider": {"const": "local"},
              "model": {"const": "deterministic-empty-canvas-v1"},
              "transport": {"const": "local.empty-canvas"}
            },
            "required": ["provider", "model", "transport", "input_mode", "parameters"]
          }
        }
      }
    }
  ]
}
