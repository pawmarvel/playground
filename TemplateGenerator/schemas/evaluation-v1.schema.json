{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pawmarvel.com/schemas/evaluation-v1.schema.json",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "review_id",
    "kind",
    "design_id",
    "product_profile_id",
    "candidates",
    "hard_gates"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "review_id": {"type": "string", "minLength": 1},
    "design_id": {"type": "string", "minLength": 1},
    "product_profile_id": {"type": "string", "minLength": 1},
    "kind": {"enum": ["art", "pet", "layout", "assembly"]},
    "attempt_id_prefix": {"type": ["string", "null"], "minLength": 1},
    "review_mode": {"enum": ["source-output", "composed-preview"]},
    "candidates": {"type": "array", "minItems": 1},
    "review_artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "path", "sha256"],
        "properties": {
          "kind": {"type": "string"},
          "path": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "hard_gates": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {"enum": ["passed", "failed"]}
      }
    }
  }
}
