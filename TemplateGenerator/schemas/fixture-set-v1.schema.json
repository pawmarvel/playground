{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pawmarvel.com/schemas/fixture-set-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "fixture_set_id", "fixtures"],
  "properties": {
    "schema_version": {"const": 1},
    "fixture_set_id": {"type": "string", "minLength": 1},
    "fixtures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "pet_image"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+[a-z0-9]$"},
          "pet_image": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
