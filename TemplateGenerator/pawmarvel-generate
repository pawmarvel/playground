#!/bin/sh
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
project_python="$script_dir/.venv/bin/python"
workspace_python="$script_dir/../.venv/bin/python"

if [ -x "$project_python" ]; then
    python_cmd="$project_python"
elif [ -x "$workspace_python" ]; then
    python_cmd="$workspace_python"
else
    python_cmd="python3"
fi

PYTHONPATH="$script_dir/src${PYTHONPATH:+:$PYTHONPATH}" \
    exec "$python_cmd" -m pawmarvel_generator.cli "$@"
